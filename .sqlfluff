[sqlfluff]
dialect = duckdb
templater = jinja
max_line_length = 100
exclude_rules = RF03, RF04, RF06, ST07, AM04, AL03

[sqlfluff:indentation]
indented_joins = False
indented_using_on = True
template_blocks_indent = True

[sqlfluff:templater:jinja:context]
events_csv = 'events.csv'
properties_part1_csv = 'item_properties_part1.csv'
properties_part2_csv = 'item_properties_part2.csv'
category_tree_csv = 'category_tree.csv'
session_gap_milliseconds = 1800000
